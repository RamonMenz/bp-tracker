# Copie este arquivo para .env.local e preencha com os valores do seu projeto Firebase.
# .env.local é gitignored: cada ambiente (dev/prod) aponta para um projeto diferente.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Opcional — necessária apenas para FCM na web (Console > Cloud Messaging > Web Push certificates).
EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# OAuth Web Client ID (Google Cloud Console > Credenciais > OAuth 2.0 Client IDs > tipo "Web").
# Usado por @react-native-google-signin/google-signin no login nativo — não confundir com o
# Android client ID gerado no google-services.json.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# App Check na web: site key do reCAPTCHA Enterprise (Cloud Console > Security > reCAPTCHA
# Enterprise). Pública por design, igual à config do Firebase.
EXPO_PUBLIC_APPCHECK_RECAPTCHA_SITE_KEY=

# Coletor de erro em produção na web: DSN do Sentry (sentry.io > Settings > Projects > seu
# projeto > Client Keys (DSN)). Pública por design, igual à config do Firebase — vai no bundle
# client-side. Opcional: sem ela o coletor web apenas não inicializa, sem quebrar o app.
EXPO_PUBLIC_SENTRY_DSN=

# ⚠️ SOMENTE DESENVOLVIMENTO — NUNCA defina esta variável num build de produção ou nos secrets
# do EAS/CI. Um debug token registrado no Console dá acesso irrestrito à sua API burlando o
# App Check: trate como credencial, não como configuração. O código só a lê dentro de
# `if (__DEV__)`, bloco que o Metro remove no build de produção.
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=
