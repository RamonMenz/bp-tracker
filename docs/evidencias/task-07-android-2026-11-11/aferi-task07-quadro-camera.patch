diff --git a/src/services/recognition/frame-diagnostic.ts b/src/services/recognition/frame-diagnostic.ts
new file mode 100644
--- /dev/null
+++ b/src/services/recognition/frame-diagnostic.ts
@@ -0,0 +1,22 @@
+/** Projecao limitada de metadados nativos. Nao serializar objetos/erros do SDK. */
+export function describeFrameFailure(value: unknown): readonly string[] {
+  if (!value || typeof value !== 'object') return [];
+  const data = value as Record<string, unknown>;
+  const reasons = ['frame-format', 'frame-size', 'frame-stride', 'frame-plane', 'frame-copy'];
+  if (data.revision !== 'frame-1' || typeof data.reason !== 'string' || !reasons.includes(data.reason)) return [];
+  const integer = (v: unknown, maximum: number): v is number => typeof v === 'number'
+    && Number.isInteger(v) && v >= 0 && v <= maximum;
+  if (!integer(data.width, 100000) || !integer(data.height, 100000)
+    || !integer(data.format, 1000) || !integer(data.planeCount, 8)
+    || ![0, 90, 180, 270].includes(data.rotation as number)) return [];
+  const lines = [`quadro:motivo=${data.reason}`,
+    `quadro:${data.width}x${data.height}; formato=${data.format}; planos=${data.planeCount}; rot=${data.rotation}`];
+  if (Array.isArray(data.planes)) for (const [index, item] of data.planes.slice(0, 3).entries()) {
+    if (!item || typeof item !== 'object') continue;
+    const plane = item as Record<string, unknown>;
+    const fields = ['rowStride', 'pixelStride', 'position', 'limit'] as const;
+    if (!fields.every(key => integer(plane[key], 2147483647))) continue;
+    lines.push(`plano${index}:linha=${plane.rowStride}; pixel=${plane.pixelStride}; pos=${plane.position}; limite=${plane.limit}`);
+  }
+  return lines;
+}
diff --git a/src/services/recognition/frame-diagnostic.test.ts b/src/services/recognition/frame-diagnostic.test.ts
new file mode 100644
--- /dev/null
+++ b/src/services/recognition/frame-diagnostic.test.ts
@@ -0,0 +1,31 @@
+import { describeFrameFailure } from './frame-diagnostic';
+
+const sample = () => ({ revision: 'frame-1', reason: 'frame-size', width: 1920, height: 1080,
+  format: 35, rotation: 90, planeCount: 3,
+  planes: [{ rowStride: 1920, pixelStride: 1, position: 0, limit: 2073600 }],
+});
+
+test('projeta somente motivo, dimensoes e strides tecnicos', () => {
+  const lines = describeFrameFailure({ ...sample(), text: 'SENTINELA', image: 'SENTINELA', systolic: 120 });
+  expect(lines).toEqual([
+    'quadro:motivo=frame-size',
+    'quadro:1920x1080; formato=35; planos=3; rot=90',
+    'plano0:linha=1920; pixel=1; pos=0; limite=2073600',
+  ]);
+  expect(JSON.stringify(lines)).not.toContain('SENTINELA');
+});
+
+test.each([null, 'SENTINELA', {}, { ...sample(), reason: 'SENTINELA' },
+  { ...sample(), width: '1920' }, { ...sample(), height: NaN },
+  { ...sample(), rotation: '90' }, { ...sample(), revision: 'unknown' },
+])('metadado malformado nao e serializado', value => {
+  expect(describeFrameFailure(value)).toEqual([]);
+});
+
+test('limita os planos e rejeita campo textual de buffer', () => {
+  const data = sample();
+  expect(describeFrameFailure({ ...data, planes: Array(50).fill(data.planes[0]) })).toHaveLength(5);
+  const result = describeFrameFailure({ ...data, planes: [{ ...data.planes[0], limit: 'SENTINELA' }] });
+  expect(result).toHaveLength(2);
+  expect(JSON.stringify(result)).not.toContain('SENTINELA');
+});
