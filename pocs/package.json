{
  "name": "aferi-recognition-pocs",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "start": "expo start --dev-client --port 8090",
    "web": "expo start --web --port 8090",
    "android": "expo run:android --port 8090",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node checks/contracts.test.mjs",
    "lint": "eslint .",
    "serve:web": "node scripts/serve-web.mjs",
    "test:web": "node checks/web-runtime.mjs",
    "preweb": "npm run prepare:ocr",
    "preexport:web": "npm run prepare:ocr",
    "prebuild:android": "expo prebuild --platform android --no-install"
  },
  "dependencies": {
    "expo": "57.0.8",
    "expo-dev-client": "57.0.13",
    "expo-modules-core": "57.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-web": "0.21.2",
    "tesseract.js": "7.0.0",
    "@tesseract.js-data/eng": "1.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/node": "22.10.0",
    "babel-preset-expo": "57.0.4",
    "typescript": "6.0.3",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.0"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
